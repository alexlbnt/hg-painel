# Configuração do Banco de Dados Neon (PostgreSQL) para Vercel / Prisma
# Exemplo de string de conexão do Neon DB:
DATABASE_URL="postgresql://usuario:senha@ep-silent-hill-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Opcional: Direct URL se estiver usando PgBouncer / Neon Pooling
# DIRECT_URL="postgresql://usuario:senha@ep-silent-hill-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# OBRIGATÓRIO em produção (mín. 16 caracteres): chave secreta para assinar os tokens de login (HMAC).
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Em desenvolvimento, se ausente, é usada uma chave local de teste.
AUTH_SECRET="troque-por-uma-chave-aleatoria-longa"

# Opcional: URL base da API quando compilado para dispositivo nativo (iOS / Android)
# EXPO_PUBLIC_API_URL="https://seu-dominio.vercel.app"
